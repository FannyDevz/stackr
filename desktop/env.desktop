# Baked into the bundled app as .env. Non-secret defaults only — the Electron
# main process overrides the important values (APP_KEY, DB, storage, URL,
# STACKR_DESKTOP, session/cache) at runtime, and real env vars win over this file.
APP_NAME=Stackr
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=UTC

STACKR_DESKTOP=1

DB_CONNECTION=sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
MAIL_MAILER=log

LOG_CHANNEL=single
LOG_LEVEL=warning
